  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "unit": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Unit"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "level": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Level"
          },
          "weekdays": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 7,
            "minItems": 1,
            "title": "Weekdays"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "unit",
          "target",
          "level",
          "weekdays"
        ],
        "title": "Action"
      },
      "Body_upload_api_goals__goal_id__evidence_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_goals__goal_id__evidence_post"
      },
      "Complete": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          },
          "reflection": {
            "type": "string",
            "maxLength": 4000,
            "title": "Reflection",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "evidence_ids",
          "confirmed"
        ],
        "title": "Complete"
      },
      "Confirm": {
        "properties": {
          "contributions": {
            "items": {
              "$ref": "#/components/schemas/Contribution"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Contributions"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "summary": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Summary"
          },
          "person_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Person Id"
          },
          "tasks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Tasks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "expected_revision",
          "summary"
        ],
        "title": "Confirm"
      },
      "Contribution": {
        "properties": {
          "action_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Action Id"
          },
          "quantity": {
            "type": "string",
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_id",
          "quantity"
        ],
        "title": "Contribution"
      },
      "Credentials": {
        "properties": {
